model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["dim_produtos", "dim_canais", "dim_regioes", "dim_calendario", "fato_vendas", "fato_orcamento", "vw_forecast_receita"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_produtos
ref table dim_canais
ref table dim_regioes
ref table dim_calendario
ref table fato_vendas
ref table fato_orcamento
ref table vw_forecast_receita

ref cultureInfo pt-BR

