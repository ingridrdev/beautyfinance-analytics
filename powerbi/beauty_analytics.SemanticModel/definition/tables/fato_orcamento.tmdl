	partition fato_orcamento = m
		mode: import
		source =
				let
				    Origem = PostgreSQL.Database("aws-0-us-west-2.pooler.supabase.com:5432", "postgres", [CreateNavigationProperties=false]),
				    Dados = Origem{[Schema="public", Item="fato_orcamento"]}[Data],
				    Tipos = Table.TransformColumnTypes(Dados, {{"id_orcamento", Int64.Type}, {"mes_referencia", type date}, {"id_produto", Int64.Type}, {"id_canal", Int64.Type}, {"id_regiao", Int64.Type}, {"quantidade_orcada", Int64.Type}, {"receita_orcada", Currency.Type}, {"custo_orcado", Currency.Type}, {"margem_orcada", Currency.Type}})
				in
				    Tipos

	annotation PBI_ResultType = Table

