// Compara metas e realizado; inclui mes abaixo da meta e futuro sem realizado.
EVALUATE
UNION(
    CALCULATETABLE(
        ROW("Cenário", "Jan-ago 2026",
            "Receita realizada", [Receita Líquida],
            "Orçamento selecionado", [Receita Orçada],
            "Orçamento comparável", [Receita Orçada Comparável],
            "Variação receita", [Variação Receita Orçamento],
            "Variação percentual (0 a 100)", [Variação Receita Orçamento %] * 100),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 1, 1), DATE(2026, 8, 31))
    ),
    CALCULATETABLE(
        ROW("Cenário", "Supermercados 2026",
            "Receita realizada", [Receita Líquida],
            "Orçamento selecionado", [Receita Orçada],
            "Orçamento comparável", [Receita Orçada Comparável],
            "Variação receita", [Variação Receita Orçamento],
            "Variação percentual (0 a 100)", [Variação Receita Orçamento %] * 100),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 1, 1), DATE(2026, 8, 31)),
        TREATAS({4}, dim_canais[id_canal])
    ),
    CALCULATETABLE(
        ROW("Cenário", "Agosto 2026",
            "Receita realizada", [Receita Líquida],
            "Orçamento selecionado", [Receita Orçada],
            "Orçamento comparável", [Receita Orçada Comparável],
            "Variação receita", [Variação Receita Orçamento],
            "Variação percentual (0 a 100)", [Variação Receita Orçamento %] * 100),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 8, 1), DATE(2026, 8, 31))
    ),
    CALCULATETABLE(
        ROW("Cenário", "Marca Lumera 2026",
            "Receita realizada", [Receita Líquida],
            "Orçamento selecionado", [Receita Orçada],
            "Orçamento comparável", [Receita Orçada Comparável],
            "Variação receita", [Variação Receita Orçamento],
            "Variação percentual (0 a 100)", [Variação Receita Orçamento %] * 100),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 1, 1), DATE(2026, 8, 31)),
        TREATAS({"Lumera"}, dim_produtos[marca])
    ),
    CALCULATETABLE(
        ROW("Cenário", "Categoria Pele 2026",
            "Receita realizada", [Receita Líquida],
            "Orçamento selecionado", [Receita Orçada],
            "Orçamento comparável", [Receita Orçada Comparável],
            "Variação receita", [Variação Receita Orçamento],
            "Variação percentual (0 a 100)", [Variação Receita Orçamento %] * 100),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 1, 1), DATE(2026, 8, 31)),
        TREATAS({"Cuidados com a Pele"}, dim_produtos[categoria])
    ),
    CALCULATETABLE(
        ROW("Cenário", "E-commerce Sudeste 2026",
            "Receita realizada", [Receita Líquida],
            "Orçamento selecionado", [Receita Orçada],
            "Orçamento comparável", [Receita Orçada Comparável],
            "Variação receita", [Variação Receita Orçamento],
            "Variação percentual (0 a 100)", [Variação Receita Orçamento %] * 100),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 1, 1), DATE(2026, 8, 31)),
        TREATAS({1}, dim_canais[id_canal]),
        TREATAS({4}, dim_regioes[id_regiao])
    ),
    CALCULATETABLE(
        ROW("Cenário", "Setembro 2026 sem realizado",
            "Receita realizada", [Receita Líquida],
            "Orçamento selecionado", [Receita Orçada],
            "Orçamento comparável", [Receita Orçada Comparável],
            "Variação receita", [Variação Receita Orçamento],
            "Variação percentual (0 a 100)", [Variação Receita Orçamento %] * 100),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 9, 1), DATE(2026, 9, 30))
    ),
    CALCULATETABLE(
        ROW("Cenário", "Agosto e setembro 2026",
            "Receita realizada", [Receita Líquida],
            "Orçamento selecionado", [Receita Orçada],
            "Orçamento comparável", [Receita Orçada Comparável],
            "Variação receita", [Variação Receita Orçamento],
            "Variação percentual (0 a 100)", [Variação Receita Orçamento %] * 100),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 8, 1), DATE(2026, 9, 30))
    )
)
ORDER BY [Cenário]
