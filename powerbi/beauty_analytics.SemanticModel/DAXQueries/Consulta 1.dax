// Testa orçamento completo, período comparável e variações de receita.
// Não cria medidas nem altera dados.
EVALUATE
UNION(
    ROW(
        "Cenário", "Total",
        "Receita realizada", [Receita Líquida],
        "Orçamento selecionado", [Receita Orçada],
        "Orçamento comparável", [Receita Orçada Comparável],
        "Variação receita", [Variação Receita Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Receita Orçamento %] * 100, 2)
    ),
    CALCULATETABLE(ROW(
        "Cenário", "Ano 2026",
        "Receita realizada", [Receita Líquida],
        "Orçamento selecionado", [Receita Orçada],
        "Orçamento comparável", [Receita Orçada Comparável],
        "Variação receita", [Variação Receita Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Receita Orçamento %] * 100, 2)
    ), dim_calendario[ano] = 2026),
    CALCULATETABLE(ROW(
        "Cenário", "Canal 1",
        "Receita realizada", [Receita Líquida],
        "Orçamento selecionado", [Receita Orçada],
        "Orçamento comparável", [Receita Orçada Comparável],
        "Variação receita", [Variação Receita Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Receita Orçamento %] * 100, 2)
    ), dim_canais[id_canal] = 1),
    CALCULATETABLE(ROW(
        "Cenário", "Agosto 2026",
        "Receita realizada", [Receita Líquida],
        "Orçamento selecionado", [Receita Orçada],
        "Orçamento comparável", [Receita Orçada Comparável],
        "Variação receita", [Variação Receita Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Receita Orçamento %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-08"),
    CALCULATETABLE(ROW(
        "Cenário", "Setembro 2026 sem realizado",
        "Receita realizada", [Receita Líquida],
        "Orçamento selecionado", [Receita Orçada],
        "Orçamento comparável", [Receita Orçada Comparável],
        "Variação receita", [Variação Receita Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Receita Orçamento %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-09"),
    CALCULATETABLE(ROW(
        "Cenário", "Agosto e setembro 2026",
        "Receita realizada", [Receita Líquida],
        "Orçamento selecionado", [Receita Orçada],
        "Orçamento comparável", [Receita Orçada Comparável],
        "Variação receita", [Variação Receita Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Receita Orçamento %] * 100, 2)
    ), dim_calendario[ano_mes] IN {"2026-08", "2026-09"})
)
ORDER BY [Cenário]
