// Testa as medidas permanentes de pedidos, unidades e ticket médio.
// Não cria medidas nem altera dados.
EVALUATE
UNION(
    ROW(
        "Cenário", "Total realizado",
        "Receita líquida", [Receita Líquida],
        "Pedidos", [Pedidos],
        "Unidades vendidas", [Unidades Vendidas],
        "Ticket médio", ROUND([Ticket Médio], 2)
    ),
    CALCULATETABLE(
        ROW(
            "Cenário", "Canal 1",
            "Receita líquida", [Receita Líquida],
            "Pedidos", [Pedidos],
            "Unidades vendidas", [Unidades Vendidas],
            "Ticket médio", ROUND([Ticket Médio], 2)
        ),
        dim_canais[id_canal] = 1
    ),
    CALCULATETABLE(
        ROW(
            "Cenário", "Produto 1",
            "Receita líquida", [Receita Líquida],
            "Pedidos", [Pedidos],
            "Unidades vendidas", [Unidades Vendidas],
            "Ticket médio", ROUND([Ticket Médio], 2)
        ),
        dim_produtos[id_produto] = 1
    ),
    CALCULATETABLE(
        ROW(
            "Cenário", "Agosto 2026",
            "Receita líquida", [Receita Líquida],
            "Pedidos", [Pedidos],
            "Unidades vendidas", [Unidades Vendidas],
            "Ticket médio", ROUND([Ticket Médio], 2)
        ),
        dim_calendario[ano_mes] = "2026-08"
    ),
    CALCULATETABLE(
        ROW(
            "Cenário", "Setembro 2026 sem realizado",
            "Receita líquida", [Receita Líquida],
            "Pedidos", [Pedidos],
            "Unidades vendidas", [Unidades Vendidas],
            "Ticket médio", ROUND([Ticket Médio], 2)
        ),
        dim_calendario[ano_mes] = "2026-09"
    )
)
ORDER BY [Cenário]
