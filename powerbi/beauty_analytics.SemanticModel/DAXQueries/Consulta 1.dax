// Confere as medidas usadas na Visão Executiva nos três recortes de referência.
// Não cria medidas nem altera dados. A renderização e as interações são conferidas na página.
EVALUATE
UNION(
    CALCULATETABLE(ROW(
        "Cenário", "Inicial 2026 até agosto",
        "Receita líquida", [Receita Líquida],
        "Custo total", [Custo Total],
        "Margem bruta", [Margem Bruta],
        "Margem percentual (0 a 100)", ROUND([Margem Percentual] * 100, 2),
        "Pedidos", [Pedidos],
        "Ticket médio", ROUND([Ticket Médio], 2),
        "Orçamento comparável", [Receita Orçada Comparável],
        "Variação receita", [Variação Receita Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Receita Orçamento %] * 100, 2)
    ), dim_calendario[ano] = 2026, dim_calendario[data] <= DATE(2026, 8, 31)),
    CALCULATETABLE(ROW(
        "Cenário", "Agosto 2026",
        "Receita líquida", [Receita Líquida],
        "Custo total", [Custo Total],
        "Margem bruta", [Margem Bruta],
        "Margem percentual (0 a 100)", ROUND([Margem Percentual] * 100, 2),
        "Pedidos", [Pedidos],
        "Ticket médio", ROUND([Ticket Médio], 2),
        "Orçamento comparável", [Receita Orçada Comparável],
        "Variação receita", [Variação Receita Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Receita Orçamento %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-08"),
    CALCULATETABLE(ROW(
        "Cenário", "Canal 1 agosto 2026",
        "Receita líquida", [Receita Líquida],
        "Custo total", [Custo Total],
        "Margem bruta", [Margem Bruta],
        "Margem percentual (0 a 100)", ROUND([Margem Percentual] * 100, 2),
        "Pedidos", [Pedidos],
        "Ticket médio", ROUND([Ticket Médio], 2),
        "Orçamento comparável", [Receita Orçada Comparável],
        "Variação receita", [Variação Receita Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Receita Orçamento %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-08", dim_canais[id_canal] = 1)
)
ORDER BY [Cenário]
