// Testa forecast da empresa, meses e filtros sem detalhamento suportado.
// Nao cria medidas nem altera dados.
EVALUATE
UNION(
    ROW(
        "Cenário", "Total forecast",
        "Receita prevista", [Previsão Receita],
        "Orçamento período forecast", [Orçamento Período Forecast],
        "Variação forecast", [Variação Forecast Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Forecast Orçamento %] * 100, 2)
    ),
    CALCULATETABLE(ROW(
        "Cenário", "Setembro 2026",
        "Receita prevista", [Previsão Receita],
        "Orçamento período forecast", [Orçamento Período Forecast],
        "Variação forecast", [Variação Forecast Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Forecast Orçamento %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-09"),
    CALCULATETABLE(ROW(
        "Cenário", "Dezembro 2026",
        "Receita prevista", [Previsão Receita],
        "Orçamento período forecast", [Orçamento Período Forecast],
        "Variação forecast", [Variação Forecast Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Forecast Orçamento %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-12"),
    CALCULATETABLE(ROW(
        "Cenário", "Agosto 2026 sem forecast",
        "Receita prevista", [Previsão Receita],
        "Orçamento período forecast", [Orçamento Período Forecast],
        "Variação forecast", [Variação Forecast Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Forecast Orçamento %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-08"),
    CALCULATETABLE(ROW(
        "Cenário", "Agosto e setembro 2026",
        "Receita prevista", [Previsão Receita],
        "Orçamento período forecast", [Orçamento Período Forecast],
        "Variação forecast", [Variação Forecast Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Forecast Orçamento %] * 100, 2)
    ), dim_calendario[ano_mes] IN {"2026-08", "2026-09"}),
    CALCULATETABLE(ROW(
        "Cenário", "Canal 1 sem detalhamento",
        "Receita prevista", [Previsão Receita],
        "Orçamento período forecast", [Orçamento Período Forecast],
        "Variação forecast", [Variação Forecast Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Forecast Orçamento %] * 100, 2)
    ), dim_canais[id_canal] = 1),
    CALCULATETABLE(ROW(
        "Cenário", "Produto 1 sem detalhamento",
        "Receita prevista", [Previsão Receita],
        "Orçamento período forecast", [Orçamento Período Forecast],
        "Variação forecast", [Variação Forecast Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Forecast Orçamento %] * 100, 2)
    ), dim_produtos[id_produto] = 1),
    CALCULATETABLE(ROW(
        "Cenário", "Região 1 sem detalhamento",
        "Receita prevista", [Previsão Receita],
        "Orçamento período forecast", [Orçamento Período Forecast],
        "Variação forecast", [Variação Forecast Orçamento],
        "Variação percentual (0 a 100)", ROUND([Variação Forecast Orçamento %] * 100, 2)
    ), dim_regioes[id_regiao] = 1)
)
ORDER BY [Cenário]
