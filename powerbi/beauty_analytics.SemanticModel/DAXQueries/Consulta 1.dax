// Testa medidas MoM em meses completos, troca de ano, canal e ausencia de base.
// Nao cria medidas nem altera dados.
EVALUATE
UNION(
    ROW(
        "Cenário", "Total sem mês único",
        "Receita atual", [Receita Líquida],
        "Receita mês anterior", [Receita Mês Anterior],
        "Variação receita MoM", [Variação Receita MoM],
        "Crescimento MoM (0 a 100)", ROUND([Crescimento Receita MoM %] * 100, 2)
    ),
    CALCULATETABLE(ROW(
        "Cenário", "Janeiro 2024",
        "Receita atual", [Receita Líquida],
        "Receita mês anterior", [Receita Mês Anterior],
        "Variação receita MoM", [Variação Receita MoM],
        "Crescimento MoM (0 a 100)", ROUND([Crescimento Receita MoM %] * 100, 2)
    ), dim_calendario[ano_mes] = "2024-01"),
    CALCULATETABLE(ROW(
        "Cenário", "Fevereiro 2024",
        "Receita atual", [Receita Líquida],
        "Receita mês anterior", [Receita Mês Anterior],
        "Variação receita MoM", [Variação Receita MoM],
        "Crescimento MoM (0 a 100)", ROUND([Crescimento Receita MoM %] * 100, 2)
    ), dim_calendario[ano_mes] = "2024-02"),
    CALCULATETABLE(ROW(
        "Cenário", "Novembro 2024",
        "Receita atual", [Receita Líquida],
        "Receita mês anterior", [Receita Mês Anterior],
        "Variação receita MoM", [Variação Receita MoM],
        "Crescimento MoM (0 a 100)", ROUND([Crescimento Receita MoM %] * 100, 2)
    ), dim_calendario[ano_mes] = "2024-11"),
    CALCULATETABLE(ROW(
        "Cenário", "Janeiro 2025",
        "Receita atual", [Receita Líquida],
        "Receita mês anterior", [Receita Mês Anterior],
        "Variação receita MoM", [Variação Receita MoM],
        "Crescimento MoM (0 a 100)", ROUND([Crescimento Receita MoM %] * 100, 2)
    ), dim_calendario[ano_mes] = "2025-01"),
    CALCULATETABLE(ROW(
        "Cenário", "Agosto 2026",
        "Receita atual", [Receita Líquida],
        "Receita mês anterior", [Receita Mês Anterior],
        "Variação receita MoM", [Variação Receita MoM],
        "Crescimento MoM (0 a 100)", ROUND([Crescimento Receita MoM %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-08"),
    CALCULATETABLE(ROW(
        "Cenário", "Canal 1 agosto 2026",
        "Receita atual", [Receita Líquida],
        "Receita mês anterior", [Receita Mês Anterior],
        "Variação receita MoM", [Variação Receita MoM],
        "Crescimento MoM (0 a 100)", ROUND([Crescimento Receita MoM %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-08", dim_canais[id_canal] = 1),
    CALCULATETABLE(ROW(
        "Cenário", "Setembro 2026 sem realizado",
        "Receita atual", [Receita Líquida],
        "Receita mês anterior", [Receita Mês Anterior],
        "Variação receita MoM", [Variação Receita MoM],
        "Crescimento MoM (0 a 100)", ROUND([Crescimento Receita MoM %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-09"),
    CALCULATETABLE(ROW(
        "Cenário", "Agosto e setembro 2026",
        "Receita atual", [Receita Líquida],
        "Receita mês anterior", [Receita Mês Anterior],
        "Variação receita MoM", [Variação Receita MoM],
        "Crescimento MoM (0 a 100)", ROUND([Crescimento Receita MoM %] * 100, 2)
    ), dim_calendario[ano_mes] IN {"2026-08", "2026-09"})
)
ORDER BY [Cenário]
