// Testa YoY mensal: historico, queda, crescimento, fevereiro, canal e contextos sem comparacao.
// Nao cria medidas nem altera dados.
EVALUATE
UNION(
    ROW(
        "Cenário", "Total sem mês único",
        "Receita atual", [Receita Líquida],
        "Receita mesmo mês ano anterior", [Receita Mesmo Mês Ano Anterior],
        "Variação receita YoY", [Variação Receita YoY],
        "Crescimento YoY (0 a 100)", ROUND([Crescimento Receita YoY %] * 100, 2)
    ),
    CALCULATETABLE(ROW(
        "Cenário", "Agosto 2024 sem histórico",
        "Receita atual", [Receita Líquida],
        "Receita mesmo mês ano anterior", [Receita Mesmo Mês Ano Anterior],
        "Variação receita YoY", [Variação Receita YoY],
        "Crescimento YoY (0 a 100)", ROUND([Crescimento Receita YoY %] * 100, 2)
    ), dim_calendario[ano_mes] = "2024-08"),
    CALCULATETABLE(ROW(
        "Cenário", "Janeiro 2025",
        "Receita atual", [Receita Líquida],
        "Receita mesmo mês ano anterior", [Receita Mesmo Mês Ano Anterior],
        "Variação receita YoY", [Variação Receita YoY],
        "Crescimento YoY (0 a 100)", ROUND([Crescimento Receita YoY %] * 100, 2)
    ), dim_calendario[ano_mes] = "2025-01"),
    CALCULATETABLE(ROW(
        "Cenário", "Fevereiro 2025",
        "Receita atual", [Receita Líquida],
        "Receita mesmo mês ano anterior", [Receita Mesmo Mês Ano Anterior],
        "Variação receita YoY", [Variação Receita YoY],
        "Crescimento YoY (0 a 100)", ROUND([Crescimento Receita YoY %] * 100, 2)
    ), dim_calendario[ano_mes] = "2025-02"),
    CALCULATETABLE(ROW(
        "Cenário", "Julho 2026",
        "Receita atual", [Receita Líquida],
        "Receita mesmo mês ano anterior", [Receita Mesmo Mês Ano Anterior],
        "Variação receita YoY", [Variação Receita YoY],
        "Crescimento YoY (0 a 100)", ROUND([Crescimento Receita YoY %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-07"),
    CALCULATETABLE(ROW(
        "Cenário", "Agosto 2026",
        "Receita atual", [Receita Líquida],
        "Receita mesmo mês ano anterior", [Receita Mesmo Mês Ano Anterior],
        "Variação receita YoY", [Variação Receita YoY],
        "Crescimento YoY (0 a 100)", ROUND([Crescimento Receita YoY %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-08"),
    CALCULATETABLE(ROW(
        "Cenário", "Canal 1 agosto 2026",
        "Receita atual", [Receita Líquida],
        "Receita mesmo mês ano anterior", [Receita Mesmo Mês Ano Anterior],
        "Variação receita YoY", [Variação Receita YoY],
        "Crescimento YoY (0 a 100)", ROUND([Crescimento Receita YoY %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-08", dim_canais[id_canal] = 1),
    CALCULATETABLE(ROW(
        "Cenário", "Setembro 2026 sem realizado",
        "Receita atual", [Receita Líquida],
        "Receita mesmo mês ano anterior", [Receita Mesmo Mês Ano Anterior],
        "Variação receita YoY", [Variação Receita YoY],
        "Crescimento YoY (0 a 100)", ROUND([Crescimento Receita YoY %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-09"),
    CALCULATETABLE(ROW(
        "Cenário", "Ano 2026 sem mês único",
        "Receita atual", [Receita Líquida],
        "Receita mesmo mês ano anterior", [Receita Mesmo Mês Ano Anterior],
        "Variação receita YoY", [Variação Receita YoY],
        "Crescimento YoY (0 a 100)", ROUND([Crescimento Receita YoY %] * 100, 2)
    ), dim_calendario[ano] = 2026),
    CALCULATETABLE(ROW(
        "Cenário", "Agosto 2026 dias 1 a 15",
        "Receita atual", [Receita Líquida],
        "Receita mesmo mês ano anterior", [Receita Mesmo Mês Ano Anterior],
        "Variação receita YoY", [Variação Receita YoY],
        "Crescimento YoY (0 a 100)", ROUND([Crescimento Receita YoY %] * 100, 2)
    ), dim_calendario[ano_mes] = "2026-08", dim_calendario[dia] <= 15)
)
ORDER BY [Cenário]
