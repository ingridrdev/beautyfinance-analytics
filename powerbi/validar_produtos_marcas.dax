// Valida os seis indicadores da página; não cria medidas nem altera dados.
EVALUATE
UNION(
    CALCULATETABLE(
        ROW("Cenário", "Jan-ago 2026",
            "Receita líquida", [Receita Líquida],
            "Custo total", [Custo Total],
            "Margem bruta", [Margem Bruta],
            "Margem percentual", [Margem Percentual],
            "Unidades vendidas", [Unidades Vendidas],
            "Ticket médio", [Ticket Médio]),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 1, 1), DATE(2026, 8, 31))
    ),
    CALCULATETABLE(
        ROW("Cenário", "Produto 1",
            "Receita líquida", [Receita Líquida],
            "Custo total", [Custo Total],
            "Margem bruta", [Margem Bruta],
            "Margem percentual", [Margem Percentual],
            "Unidades vendidas", [Unidades Vendidas],
            "Ticket médio", [Ticket Médio]),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 1, 1), DATE(2026, 8, 31)),
        TREATAS({1}, dim_produtos[id_produto])
    ),
    CALCULATETABLE(
        ROW("Cenário", "Marca Lumera",
            "Receita líquida", [Receita Líquida],
            "Custo total", [Custo Total],
            "Margem bruta", [Margem Bruta],
            "Margem percentual", [Margem Percentual],
            "Unidades vendidas", [Unidades Vendidas],
            "Ticket médio", [Ticket Médio]),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 1, 1), DATE(2026, 8, 31)),
        TREATAS({"Lumera"}, dim_produtos[marca])
    ),
    CALCULATETABLE(
        ROW("Cenário", "Categoria Cuidados com a Pele",
            "Receita líquida", [Receita Líquida],
            "Custo total", [Custo Total],
            "Margem bruta", [Margem Bruta],
            "Margem percentual", [Margem Percentual],
            "Unidades vendidas", [Unidades Vendidas],
            "Ticket médio", [Ticket Médio]),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 1, 1), DATE(2026, 8, 31)),
        TREATAS({"Cuidados com a Pele"}, dim_produtos[categoria])
    ),
    CALCULATETABLE(
        ROW("Cenário", "Agosto 2026",
            "Receita líquida", [Receita Líquida],
            "Custo total", [Custo Total],
            "Margem bruta", [Margem Bruta],
            "Margem percentual", [Margem Percentual],
            "Unidades vendidas", [Unidades Vendidas],
            "Ticket médio", [Ticket Médio]),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 1, 1), DATE(2026, 8, 31)),
        TREATAS({"2026-08"}, dim_calendario[ano_mes])
    ),
    CALCULATETABLE(
        ROW("Cenário", "Produto 1 agosto 2026",
            "Receita líquida", [Receita Líquida],
            "Custo total", [Custo Total],
            "Margem bruta", [Margem Bruta],
            "Margem percentual", [Margem Percentual],
            "Unidades vendidas", [Unidades Vendidas],
            "Ticket médio", [Ticket Médio]),
        REMOVEFILTERS(),
        DATESBETWEEN(dim_calendario[data], DATE(2026, 1, 1), DATE(2026, 8, 31)),
        TREATAS({1}, dim_produtos[id_produto]), TREATAS({"2026-08"}, dim_calendario[ano_mes])
    )
)
ORDER BY [Cenário]
